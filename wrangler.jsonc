{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "srhr-rams",
  "main": "src/index.js",
  "compatibility_date": "2026-10-06",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "srhr-rams-db",
      "database_id": "5d34262b-769e-47e0-aa64-c1922a06e85c"
    }
  ]
  // After: npx wrangler r2 bucket create srhr-rams-documents
  // "r2_buckets": [{ "binding": "DOCUMENTS", "bucket_name": "srhr-rams-documents" }]
}
